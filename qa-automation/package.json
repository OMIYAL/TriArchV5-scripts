{
    "name": "triarch-qa-automation",
    "version": "1.0.0",
    "description": "QA Automation for TriArch V5",
    "scripts": {
        "auth:setup": "playwright test --project=setup",
        "test": "playwright test",
        "test:headed": "playwright test --headed",
        "test:dev": "playwright test --project=chromium --no-deps",
        "test:dev:headed": "playwright test --project=chromium --no-deps --headed",
        "test:smoke": "playwright test --grep @smoke",
        "bddgen": "bddgen",
        "test:bdd": "bddgen && playwright test --project=bdd-storefront",
        "test:bdd:smoke": "bddgen && playwright test --project=bdd-storefront --grep @smoke",
        "test:bdd:headed": "bddgen && playwright test --project=bdd-storefront --headed",
        "test:storefront:headed": "bddgen && playwright test --project=storefront-chromium --headed",
        "show-report": "playwright show-report",
        "test:debug": "playwright test --debug --project=chromium --no-deps"
    },
    "keywords": [
        "playwright",
        "automation",
        "testing"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@playwright/test": "^1.40.0",
        "@types/node": "^20.0.0",
        "playwright-bdd": "^9.2.0"
    },
    "dependencies": {
        "dotenv": "^16.6.1"
    }
}
