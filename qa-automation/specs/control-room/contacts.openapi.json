{
  "openapi": "3.0.1",
  "info": {
    "title": "TriArch Control Room Contacts (slice)",
    "version": "1.0",
    "description": "Slim OpenAPI slice for Spec → Gherkin → Code demo. Source: POST /api/control-room/contacts from TriArchV5 Swagger."
  },
  "paths": {
    "/api/control-room/contacts": {
      "post": {
        "tags": ["Contact"],
        "summary": "Create Control Room contact",
        "operationId": "ContactCreate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactCreateDto"
              },
              "example": {
                "firstName": "Qateam",
                "lastName": "ContactDemo",
                "email": "qa.contact.create@example.com",
                "phone": "5551234567",
                "company": "TriArch QAteam"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContactCreateDto": {
        "required": ["firstName", "email"],
        "type": "object",
        "properties": {
          "firstName": {
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "phone": {
            "maxLength": 32,
            "minLength": 0,
            "pattern": "^[0-9+\\-().\\s]*$",
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "company": {
            "type": "string",
            "nullable": true
          },
          "licenseNo": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "tagsIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}
