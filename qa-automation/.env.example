# ============================================================
# TriArch QA Automation - Environment Configuration Template
# Copy this file to .env and fill in your tenant's values.
# ============================================================

# --- Portal URL ---
BASE_URL=https://stg-portal.triarch.ai/

# --- Auth Server URL ---
AUTH_URL=https://stg-auth.triarch.ai/

# --- Tenant Configuration ---
# The tenant name entered in the "Switch Tenant" modal on the login page
TENANT_NAME=your-tenant-name

# --- Login Credentials ---
USER_NAME=your-username
USER_PASSWORD=your-password
