# ============================================================
# TriArch QA Automation — .env.example
#
# Copy this file to .env and fill in real values.
# The .env file is git-ignored and must NEVER be committed.
#
# HOW ENVIRONMENT SELECTION WORKS
# ─────────────────────────────────
# Set TEST_ENV to switch the active environment locally:
#   TEST_ENV=stg   → uses STG_* prefixed keys below
#   TEST_ENV=prod  → uses PROD_* prefixed keys below
#
# In CI, TEST_ENV is set automatically from the workflow's
# `environment` input (staging / production).
# CI secrets injected by GitHub take precedence over any
# .env prefix-resolved values.
#
# RANDOM-SELECTION KEYS (no STG_/PROD_ prefix needed)
# ──────────────────────────────────────────────────────
# The following keys are intentionally NOT prefixed because
# random selection is the correct behaviour on all environments:
#
#   SERVICE_NAME      — when unset, a random available service is picked
#                       (same pattern on staging and production tenant)
#   TEST_DEFAULT_PDF  — when unset, a random fixture PDF is used
#   TEST_DOCUMENTS_DIR — when unset, defaults to the repo fixtures/ folder
#
# ============================================================

TEST_ENV=stg

# ═══════════════════════════════════════════════════════════════════════
# BASE URLS
# ═══════════════════════════════════════════════════════════════════════
STG_STOREFRONT_BASE_URL=
STG_PORTAL_BASE_URL=
STG_AUTH_BASE_URL=

PROD_STOREFRONT_BASE_URL=
PROD_PORTAL_BASE_URL=
PROD_AUTH_BASE_URL=

# ═══════════════════════════════════════════════════════════════════════
# TENANT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════
# TENANT_NAME is the single knob to switch tenants.
#
# At startup, env.config.ts automatically prepends TENANT_NAME to the
# hostname of STOREFRONT_BASE_URL and PORTAL_BASE_URL, producing
# tenant-specific subdomain URLs:
#
#   STG_TENANT_NAME=fps
#   STG_STOREFRONT_BASE_URL=https://stg-storefront.triarch.ai
#   → runtime STOREFRONT_BASE_URL = https://fps.stg-storefront.triarch.ai
#
# To target a different tenant, change only TENANT_NAME — no other
# values need to be touched.
#
# AUTH_BASE_URL is NOT subdomained — the auth service runs on the shared
# host and receives tenant context via the OIDC redirect from the subdomain.
STG_TENANT_NAME=your-stg-tenant
PROD_TENANT_NAME=your-prod-tenant

# ═══════════════════════════════════════════════════════════════════════
# CITIZEN CREDENTIALS (Storefront)
# ═══════════════════════════════════════════════════════════════════════
STG_CITIZEN_USERNAME=
STG_CITIZEN_PASSWORD=

PROD_CITIZEN_USERNAME=
PROD_CITIZEN_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════
# COORDINATOR CREDENTIALS (Portal - Assigns reviews)
# ═══════════════════════════════════════════════════════════════════════
STG_COORDINATOR_USERNAME=
STG_COORDINATOR_PASSWORD=

PROD_COORDINATOR_USERNAME=
PROD_COORDINATOR_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════
# REVIEWER CREDENTIALS (Portal - Reviews requests)
# ═══════════════════════════════════════════════════════════════════════
# Main reviewer (single-reviewer workflow)
STG_REVIEWER_USERNAME=
STG_REVIEWER_PASSWORD=

# Reviewer 1 (first reviewer in dual-reviewer scenario)
STG_REVIEWER1_USERNAME=
STG_REVIEWER1_PASSWORD=

# Reviewer 2 (second reviewer in dual-reviewer scenario)
STG_REVIEWER2_USERNAME=
STG_REVIEWER2_PASSWORD=

PROD_REVIEWER_USERNAME=
PROD_REVIEWER_PASSWORD=
PROD_REVIEWER1_USERNAME=
PROD_REVIEWER1_PASSWORD=
PROD_REVIEWER2_USERNAME=
PROD_REVIEWER2_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════
# STRIPE TEST CREDENTIALS
# Both STG and PROD tenants must be on Stripe test keys for these to work.
# Use Stripe's standard test card: 4242 4242 4242 4242
# ═══════════════════════════════════════════════════════════════════════
STG_STRIPE_TEST_EMAIL=test@your-domain.ai
STG_STRIPE_TEST_CARD_NUMBER=4242424242424242
STG_STRIPE_TEST_EXPIRATION=12/34
STG_STRIPE_TEST_CVC=123
STG_STRIPE_TEST_CARDHOLDER_NAME=Test User
STG_STRIPE_TEST_ZIP=12345
# Optional — only used if Stripe requests a phone number during checkout
STG_STRIPE_TEST_PHONE=2015550123

PROD_STRIPE_TEST_EMAIL=test@your-domain.ai
PROD_STRIPE_TEST_CARD_NUMBER=4242424242424242
PROD_STRIPE_TEST_EXPIRATION=12/34
PROD_STRIPE_TEST_CVC=123
PROD_STRIPE_TEST_CARDHOLDER_NAME=Test User
PROD_STRIPE_TEST_ZIP=12345
PROD_STRIPE_TEST_PHONE=2015550123
