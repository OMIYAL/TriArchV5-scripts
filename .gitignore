# ============================================================
# TriArch QA Automation — .gitignore
# Root of the mono-repo: TriArchV5-scripts/
# ============================================================

# ─── Secrets & Environment ───────────────────────────────────
# .env holds all credentials, URLs, and API keys.
# NEVER commit this. Use .env.example as the template.
.env
.env.local
.env.*.local
.env.example

# ─── Node ────────────────────────────────────────────────────
node_modules/

# ─── Playwright: Test Output ─────────────────────────────────
# Generated on every run — large, binary, and machine-specific.
test-results/
playwright-report/
**/.features-gen/

# Individual artifact types (in case paths differ per project)
**/*.webm
**/*.zip
**/trace.zip
**/error-context.md

# ─── Playwright: Auth State ──────────────────────────────────
# Auto-generated by auth.setup.ts — contains live session tokens.
# Keep the folder (via .gitkeep) but never the JSON contents.
playwright/.auth/*.json
**/auth-state.json

# ─── Playwright: State Chain Files ───────────────────────────
# JSON files written between test phases (citizen → coordinator
# → reviewer → certificate). These are runtime artefacts, not
# source files. The state/ folder itself is created at runtime.
test-results/state/
**/state/*.json

# ─── Playwright: Cache ───────────────────────────────────────
playwright/.cache/

# ─── TypeScript Build Output ─────────────────────────────────
dist/
build/
*.js.map

# ─── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*

# ─── OS & Editor Noise ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/settings.json
.idea/
*.suo
*.user